digraph autostart {
  rankdir=LR; nodesep=0.12; ranksep=1.2;
  graph [fontname="DejaVu Sans", fontsize=11, labelloc=b, label="зелёный: файл из пакета, dpkg -V расхождений не показал;  жёлтый: из пакета, но изменён;  красный: не принадлежит ни одному пакету"];
  node [shape=box, style=filled, fontname="DejaVu Sans", fontsize=10, fillcolor=white];
  edge [fontname="DejaVu Sans", fontsize=9];
  "/usr/lib/systemd/system/ssh.service" [label="ssh.service\n/usr/lib/systemd/system/ssh.service\nпакет openssh-server, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" [label="/usr/sbin/sshd\nпакет openssh-server, совпал", fillcolor="#bfe3bf"];
  "/usr/lib/x86_64-linux-gnu/libcrypt.so.1.1.0" [label="/usr/lib/x86_64-linux-gnu/libcrypt.so.1.1.0\nпакет libcrypt1, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libcrypt.so.1.1.0" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libwrap.so.0.7.6" [label="/usr/lib/x86_64-linux-gnu/libwrap.so.0.7.6\nпакет libwrap0, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libwrap.so.0.7.6" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libaudit.so.1.0.0" [label="/usr/lib/x86_64-linux-gnu/libaudit.so.1.0.0\nпакет libaudit1, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libaudit.so.1.0.0" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libpam.so.0.85.1" [label="/usr/lib/x86_64-linux-gnu/libpam.so.0.85.1\nпакет libpam0g, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libpam.so.0.85.1" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libselinux.so.1" [label="/usr/lib/x86_64-linux-gnu/libselinux.so.1\nпакет libselinux1, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libselinux.so.1" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libgssapi_krb5.so.2.2" [label="/usr/lib/x86_64-linux-gnu/libgssapi_krb5.so.2.2\nпакет libgssapi-krb5-2, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libgssapi_krb5.so.2.2" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libkrb5.so.3.3" [label="/usr/lib/x86_64-linux-gnu/libkrb5.so.3.3\nпакет libkrb5-3, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libkrb5.so.3.3" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libcom_err.so.2.1" [label="/usr/lib/x86_64-linux-gnu/libcom_err.so.2.1\nпакет libcom-err2, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libcom_err.so.2.1" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libcrypto.so.3" [label="/usr/lib/x86_64-linux-gnu/libcrypto.so.3\nпакет libssl3t64, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libcrypto.so.3" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libz.so.1.3" [label="/usr/lib/x86_64-linux-gnu/libz.so.1.3\nпакет zlib1g, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libz.so.1.3" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libc.so.6" [label="/usr/lib/x86_64-linux-gnu/libc.so.6\nпакет libc6, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libc.so.6" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libcap-ng.so.0.0.0" [label="/usr/lib/x86_64-linux-gnu/libcap-ng.so.0.0.0\nпакет libcap-ng0, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libcap-ng.so.0.0.0" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libpcre2-8.so.0.11.2" [label="/usr/lib/x86_64-linux-gnu/libpcre2-8.so.0.11.2\nпакет libpcre2-8-0, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libpcre2-8.so.0.11.2" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" [label="/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2\nпакет libc6, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libk5crypto.so.3.1" [label="/usr/lib/x86_64-linux-gnu/libk5crypto.so.3.1\nпакет libk5crypto3, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libk5crypto.so.3.1" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libkrb5support.so.0.1" [label="/usr/lib/x86_64-linux-gnu/libkrb5support.so.0.1\nпакет libkrb5support0, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libkrb5support.so.0.1" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libkeyutils.so.1.10" [label="/usr/lib/x86_64-linux-gnu/libkeyutils.so.1.10\nпакет libkeyutils1, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libkeyutils.so.1.10" [label="ldd"];
  "/usr/lib/x86_64-linux-gnu/libresolv.so.2" [label="/usr/lib/x86_64-linux-gnu/libresolv.so.2\nпакет libc6, совпал", fillcolor="#bfe3bf"];
  "/usr/sbin/sshd" -> "/usr/lib/x86_64-linux-gnu/libresolv.so.2" [label="ldd"];
  "/usr/lib/systemd/system/ssh.service" -> "/usr/sbin/sshd" [label="ExecStartPre"];
  "/usr/lib/systemd/system/ssh.service" -> "/usr/sbin/sshd" [label="ExecStart"];
  "/etc/default/ssh" [label="/etc/default/ssh\nпакет openssh-server, совпал", fillcolor="#bfe3bf"];
  "/usr/lib/systemd/system/ssh.service" -> "/etc/default/ssh" [label="EnvironmentFile"];
  "/etc/systemd/system/tailscale-guard.service" [label="tailscale-guard.service\n/etc/systemd/system/tailscale-guard.service\nничей", fillcolor="#f4b6b6"];
  "/usr/local/sbin/tailscale-guard.sh" [label="/usr/local/sbin/tailscale-guard.sh\nничей", fillcolor="#f4b6b6"];
  "stop:/usr/local/sbin/tailscale-guard.sh" [label="дальше не разобрано:\nнужен парсер для\nBourne-Again shell script", shape=note, style=dashed];
  "/usr/local/sbin/tailscale-guard.sh" -> "stop:/usr/local/sbin/tailscale-guard.sh" [style=dashed];
  "/etc/systemd/system/tailscale-guard.service" -> "/usr/local/sbin/tailscale-guard.sh" [label="ExecStart"];
}
